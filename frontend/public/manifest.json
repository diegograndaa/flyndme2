{
  "name": "FlyndMe — Find the cheapest place to meet your group",
  "short_name": "FlyndMe",
  "description": "Compare flights from multiple origins and find the best destination for your group.",
  "start_url": "/?source=pwa",
  "display": "standalone",
  "background_color": "#F5F3EF",
  "theme_color": "#121316",
  "orientation": "portrait-primary",
  "icons": [
    {
      "src": "/favicon.svg?v=6",
      "type": "image/svg+xml",
      "sizes": "any",
      "purpose": "any"
    },
    {
      "src": "/icon-192.png?v=6",
      "type": "image/png",
      "sizes": "192x192",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png?v=6",
      "type": "image/png",
      "sizes": "512x512",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable-512.png?v=6",
      "type": "image/png",
      "sizes": "512x512",
      "purpose": "maskable"
    },
    {
      "src": "/apple-touch-icon.png?v=6",
      "type": "image/png",
      "sizes": "180x180",
      "purpose": "any"
    }
  ],
  "display_override": ["standalone", "minimal-ui"],
  "launch_handler": {
    "client_mode": ["navigate-existing", "auto"]
  },
  "shortcuts": [
    {
      "name": "New group search",
      "short_name": "Search",
      "description": "Find the cheapest place to meet from several cities",
      "url": "/?source=shortcut",
      "icons": [{ "src": "/icon-192.png?v=6", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Round-trip search",
      "short_name": "Round trip",
      "description": "Start a search with return flights",
      "url": "/?trip=roundtrip&source=shortcut",
      "icons": [{ "src": "/icon-192.png?v=6", "sizes": "192x192", "type": "image/png" }]
    }
  ],
  "screenshots": [
    {
      "src": "/screenshots/narrow-search.jpg",
      "sizes": "412x892",
      "type": "image/jpeg",
      "form_factor": "narrow",
      "label": "Add each traveler's city and search together"
    },
    {
      "src": "/screenshots/wide-home.jpg",
      "sizes": "1280x800",
      "type": "image/jpeg",
      "form_factor": "wide",
      "label": "Many departures, one meeting point"
    }
  ],
  "categories": [
    "travel",
    "utilities"
  ],
  "lang": "en",
  "dir": "ltr",
  "id": "/",
  "scope": "/"
}
